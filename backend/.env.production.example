# ---------------------------------------------------------------------------
# Production backend configuration (Cloud Run / any container host).
#
# Do NOT commit a filled-in copy. On Cloud Run set these as environment
# variables or, for the secrets, as Secret Manager references.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# Cloud SQL over the Unix socket that Cloud Run mounts:
#   postgresql+psycopg://USER:PASSWORD@/punchin?host=/cloudsql/PROJECT:REGION:INSTANCE
# Or any managed Postgres over TCP:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/punchin?sslmode=require
DATABASE_URL=

# python -c "import secrets;print(secrets.token_urlsafe(64))"
# Store in Secret Manager, not in plain env.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# HTTPS only in production.
COOKIE_SECURE=true

# `lax` when the app and API share an origin (Firebase Hosting rewrite to
# Cloud Run). Only use `none` if the API is genuinely on another origin, and
# then CORS_ORIGINS must list the exact app origin.
COOKIE_SAMESITE=lax

# Empty for the same-origin setup. Otherwise: https://your-app.web.app
CORS_ORIGINS=

# Cloud Run and Firebase Hosting sit in front of the app, so the client IP
# arrives in X-Forwarded-For. Without this the rate limiter would key every
# request to the proxy and throttle all users together.
TRUST_PROXY_HEADERS=true

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PUNCH_MAX=10
RATE_LIMIT_PUNCH_WINDOW_SECONDS=60

LOCATION_RETENTION_DAYS=180

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
