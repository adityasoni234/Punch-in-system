# ---------------------------------------------------------------------------
# Backend settings for: PWA on Firebase (punchin-7c498), API on this laptop.
#
# Copy to backend/.env when you are serving the Firebase-hosted app, and keep
# your plain development .env somewhere safe -- the two are not interchangeable
# (COOKIE_SECURE=true stops cookies working over plain http://localhost in
# Safari).
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# Local PostgreSQL on this laptop.
DATABASE_URL=postgresql+psycopg://punchin:punchin@localhost:5432/punchin

# REQUIRED. Generate once and keep it stable, or every existing session dies:
#   python3 -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=ENSTCZZukK5qTo8Fqn7goOf4qNaMMREC8oXKYtMxEeDX_idF2uxx1kQr2Ro4SeX_XS6REN2JrATgEWkt1S8Eog

# The Cloudflare tunnel terminates TLS, so cookies must be Secure. The app and
# the API are on different origins, so the refresh cookie must be SameSite=None
# to be sent at all.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Both origins Firebase serves this project on. Exact matches, no trailing slash.
CORS_ORIGINS=https://punchin-7c498.web.app,https://punchin-7c498.firebaseapp.com

# The tunnel is a proxy: without this the login rate limiter would see every
# request as coming from the tunnel and throttle all users as one.
TRUST_PROXY_HEADERS=true

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PUNCH_MAX=10
RATE_LIMIT_PUNCH_WINDOW_SECONDS=60
LOCATION_RETENTION_DAYS=180
