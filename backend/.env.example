# ---------------------------------------------------------------------------
# Punch In System - backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Punch In System"
ENVIRONMENT=development           # development | production
DEBUG=true

# Database (PostgreSQL). psycopg3 driver.
DATABASE_URL=postgresql+psycopg://punchin:punchin@localhost:5432/punchin

# Security -- MUST be overridden in production.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_INSECURE_DEVELOPMENT_KEY_DO_NOT_USE_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookies (refresh token transport)
COOKIE_SECURE=false               # true in production (HTTPS only)
COOKIE_SAMESITE=lax               # lax for same-origin deploy, none for cross-site
COOKIE_DOMAIN=

# CORS -- comma separated. Leave empty for a same-origin deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits  (requests / window seconds)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PUNCH_MAX=10
RATE_LIMIT_PUNCH_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Location data retention (days). Coordinates older than this are purged by
# the retention job; the attendance record itself is kept forever.
LOCATION_RETENTION_DAYS=180

# Trust the X-Forwarded-For header (only enable behind a trusted reverse proxy)
TRUST_PROXY_HEADERS=false
