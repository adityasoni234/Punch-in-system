# ---------------------------------------------------------------------------
# Backend settings for: API on your laptop, app on Firebase Hosting.
#
# The two are on DIFFERENT origins, so the refresh cookie has to be relaxed to
# SameSite=None (which requires Secure, hence HTTPS via the tunnel) and the app
# origin has to be allowed through CORS.
#
# This is weaker than a same-origin deployment and Safari's tracking
# prevention is unfriendly to it. It is the price of keeping the API on your
# laptop; revisit if you later move the API behind the same hostname.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# Your local PostgreSQL.
DATABASE_URL=postgresql+psycopg://punchin:punchin@localhost:5432/punchin

# python3 -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=

# The tunnel terminates TLS, so cookies must be Secure.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Exactly the Firebase app origin(s). No wildcards, no trailing slash.
CORS_ORIGINS=https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com

# The tunnel is a proxy, so the real client IP arrives in X-Forwarded-For.
# Without this every request looks like it comes from the tunnel and the login
# rate limiter throttles all users as one.
TRUST_PROXY_HEADERS=true

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PUNCH_MAX=10
RATE_LIMIT_PUNCH_WINDOW_SECONDS=60
LOCATION_RETENTION_DAYS=180
