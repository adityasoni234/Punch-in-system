# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
backend/.env
frontend/.env
frontend/.env.local

# Node
node_modules/
frontend/dist/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local development certificates — never commit the private key
frontend/certs/

# Firebase
.firebase/
firebase-debug.log

# Build-time frontend config (may reference a private tunnel URL)
frontend/.env.production

# Backend signing key — generated locally, never committed
backend/.secret_key
backend/.env.previous
backend/.env.development.bak

# Recorded by scripts/tunnel-api.sh
.tunnel-url

# Runtime logs and pids from scripts/start-all.sh
.run/
