# ---------------------------------------------------------------------------
# Frontend build-time configuration for the Firebase-hosted build.
# Copy to frontend/.env.production and fill in, then `npm run build`.
#
# These values are compiled into the JavaScript bundle and are therefore
# PUBLIC. Never put a secret here.
# ---------------------------------------------------------------------------

# Absolute URL of the API, including the /api/v1 prefix.
# With the backend running on your laptop behind a Cloudflare tunnel this is
# the tunnel's HTTPS address, e.g.
#   VITE_API_BASE_URL=https://random-words-1234.trycloudflare.com/api/v1
#
# Leave this UNSET for a same-origin deployment (the app then calls /api/v1 on
# its own origin), which is the more secure arrangement when it is available.
VITE_API_BASE_URL=
